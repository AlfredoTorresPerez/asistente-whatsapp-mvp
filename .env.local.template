# =============================================================================
# ASISTENTE WHATSAPP MVP - CONFIGURACIÓN LOCAL (Docker Compose)
# =============================================================================
# 1. Copia este archivo a .env.local
# 2. Ajusta valores sensibles (JWT_SECRET, APP_SECRET, ACCESS_TOKEN, etc.)
#    Opción A: escribirlos directamente aquí (menos seguro)
#    Opción B: guardarlos en Windows Credential Manager (recomendado)
#      .\scripts\store-local-secrets.ps1
#      .\scripts\local-start.ps1   # restaura secretos automáticamente
# 3. Ejecuta:
#      docker compose --env-file .env.local -f docker-compose.local.yml up -d
#      (si usas Opción B, primero: .\scripts\restore-local-secrets.ps1)
#
# Importante: Docker Compose NO carga .env.local automáticamente.
# Siempre usa --env-file .env.local.
#
# NO commitear .env.local (está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# PERFIL DE SPRING
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# -----------------------------------------------------------------------------
# ZONA HORARIA
# -----------------------------------------------------------------------------
TZ=America/Santiago

# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_DB=asistente_whatsapp
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant

# -----------------------------------------------------------------------------
# BACKEND JAVA (Spring Boot 3)
# -----------------------------------------------------------------------------
APP_JWT_SECRET=<<EN_WINDOWS_CREDENTIAL_MANAGER_o_rellenar_aqui>>
APP_ACCESS_TOKEN_EXPIRES_IN_SECONDS=28800
APP_DB_URL=jdbc:postgresql://postgres:5432/asistente_whatsapp
APP_DB_USERNAME=assistant
APP_DB_PASSWORD=assistant
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WhatsApp Channel — Cloud API es el canal predeterminado
# Valores: META_CLOUD_API, WEB (WhatsApp Web legacy), DISABLED
APP_WHATSAPP_CHANNEL_PROVIDER=META_CLOUD_API
APP_WHATSAPP_WEB_ENABLED=false
APP_WHATSAPP_CLOUD_API_ENABLED=true

APP_WHATSAPP_WEB_BASE_URL=http://whatsapp-web-service:3001
APP_WHATSAPP_WEB_API_KEY=dev-whatsapp-web-key
APP_WHATSAPP_WEB_DEFAULT_PHONE_NUMBER=56927305158
APP_WHATSAPP_WEB_WEBHOOK_SECRET=dev-whatsapp-web-webhook-secret
APP_WHATSAPP_WEB_WEBHOOK_TOLERANCE_SECONDS=600
APP_WHATSAPP_WEB_QR_TIMEOUT_SECONDS=120
APP_WHATSAPP_WEB_DEMO_FALLBACK_ENABLED=false

# WhatsApp Cloud API (Meta) — completar con valores reales
# Ver: docs/WHATSAPP_CLOUD_API_SETUP.md
APP_WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
APP_WHATSAPP_CLOUD_API_VERSION=v23.0
APP_WHATSAPP_CLOUD_API_APP_ID=
APP_WHATSAPP_CLOUD_API_APP_SECRET=
APP_WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
APP_WHATSAPP_CLOUD_API_BUSINESS_ACCOUNT_ID=
APP_WHATSAPP_CLOUD_API_ACCESS_TOKEN=
APP_WHATSAPP_CLOUD_API_WEBHOOK_VERIFY_TOKEN=
APP_WHATSAPP_CLOUD_API_CREDENTIAL_ENCRYPTION_SECRET=
APP_WHATSAPP_CLOUD_API_WEBHOOK_PUBLIC_URL=
APP_WHATSAPP_CLOUD_API_WEBHOOK_SIGNATURE_REQUIRED=true
APP_WHATSAPP_CLOUD_API_DRY_RUN_ENABLED=true
APP_WHATSAPP_CLOUD_API_CONNECT_TIMEOUT_SECONDS=5
APP_WHATSAPP_CLOUD_API_READ_TIMEOUT_SECONDS=15
APP_WHATSAPP_CLOUD_API_DEFAULT_PHONE_NUMBER=56927305158

# ⚠️ LOCAL-ONLY: expone cuerpo de mensajes en logs; desactivar para revisión de seguridad
APP_LOGGING_INCLUDE_MESSAGE_BODY=false

# AI Agents — safe-mode=true evita envíos reales; auto-reply=false desactiva respuestas automáticas
APP_AI_AGENTS_ENABLED=true
APP_AI_AGENTS_AUTO_REPLY_ENABLED=false
APP_AI_AGENTS_AUDIT_ENABLED=true
APP_AI_AGENTS_SAFE_MODE_ENABLED=true
APP_AI_AGENTS_OUTBOX_WORKER_INTERVAL_MS=2000
APP_AI_AGENTS_OUTBOX_BATCH_SIZE=5
APP_OPENAI_ENABLED=true
APP_OPENAI_API_KEY=<<EN_WINDOWS_CREDENTIAL_MANAGER_o_rellenar_aqui>>

# Pagos
APP_BOOKING_PAYMENT_PROVIDER=SIMULATED

# Email (simulado por defecto)
APP_EMAIL_ENABLED=false
APP_EMAIL_SIMULATION_ENABLED=true
APP_EMAIL_FROM=no-reply@demo.cl
APP_EMAIL_FROM_NAME=Centro Estetico Bella

# Calendario Google (opcional)
APP_CALENDAR_ENCRYPTION_SECRET=replace-with-32-char-random-secret-for-calendar-local
APP_CALENDAR_GOOGLE_ENABLED=false

# -----------------------------------------------------------------------------
# WHATSAPP WEB SERVICE (opcional: --profile whatsapp)
# -----------------------------------------------------------------------------
# Para activar, agregar --profile whatsapp al comando docker compose.
# Ejemplo:
#   docker compose -f docker-compose.local.yml --profile whatsapp up -d
WHATSAPP_WEB_HEADLESS=true
WHATSAPP_WEB_AUTO_CONNECT=true
WHATSAPP_WEB_COMPANY_PHONE_NUMBER=56927305158
WHATSAPP_WEB_DEFAULT_PHONE_NUMBER=56927305158
WHATSAPP_WEB_TEST_CUSTOMER_PHONE_NUMBER=56950954580
WHATSAPP_WEB_API_KEY=dev-whatsapp-web-key
WHATSAPP_WEB_WEBHOOK_SECRET=dev-whatsapp-web-webhook-secret
WHATSAPP_WEB_INIT_RETRIES=5
WHATSAPP_WEB_INIT_RETRY_DELAY_MS=10000
WHATSAPP_WEB_PUPPETEER_PROTOCOL_TIMEOUT_MS=180000
WHATSAPP_WEB_PUPPETEER_TIMEOUT_MS=180000
WHATSAPP_WEB_RUNTIME_RECOVERY_DELAY_MS=5000
WHATSAPP_WEB_CLEAN_PROFILE_LOCKS_ON_START=true
WHATSAPP_WEB_KILL_ORPHAN_CHROMIUM_ON_START=true
WHATSAPP_WEB_QR_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# FRONTEND REACT (Vite dev server via Docker - puerto 5173)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v23.0
