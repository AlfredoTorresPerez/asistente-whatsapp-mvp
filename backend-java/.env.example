SERVER_PORT=8080
APP_DB_URL=jdbc:postgresql://postgres:5432/asistente_whatsapp
APP_DB_USERNAME=assistant
APP_DB_PASSWORD=assistant
APP_JWT_SECRET=change-this-secret-in-local-development-please-2026
APP_ENVIRONMENT=local
APP_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
APP_RESET_TOKEN_EXPIRES_IN_MINUTES=30
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Selector del proveedor del canal WhatsApp.
# Local: SIMULATED
# Produccion: META_CLOUD_API
APP_WHATSAPP_CHANNEL_PROVIDER=SIMULATED

# Adaptador productivo WhatsApp Cloud API
APP_WHATSAPP_CLOUD_API_ENABLED=false
APP_WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
APP_WHATSAPP_CLOUD_API_VERSION=v23.0
APP_WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
APP_WHATSAPP_CLOUD_API_ACCESS_TOKEN=
APP_WHATSAPP_CLOUD_API_DEFAULT_PHONE_NUMBER=56950954580
APP_WHATSAPP_CLOUD_API_DRY_RUN_ENABLED=false
JAVA_OPTS=

# OpenAI para modulo Centro Estetico
APP_OPENAI_ENABLED=false
APP_OPENAI_BASE_URL=https://api.openai.com/v1/responses
APP_OPENAI_API_KEY=
APP_OPENAI_MODEL=gpt-5.4-mini
APP_OPENAI_TIMEOUT_SECONDS=30

# Orquestador multiagente
APP_AI_AGENTS_ENABLED=true
APP_AI_AGENTS_AUTO_REPLY_ENABLED=true
APP_AI_AGENTS_AUDIT_ENABLED=true
APP_AI_AGENTS_DEFAULT_CONFIDENCE=0.78
APP_AI_AGENTS_OUTBOX_WORKER_INTERVAL_MS=5000
APP_AI_AGENTS_OUTBOX_BATCH_SIZE=10
APP_AI_AGENTS_OUTBOX_PROCESSING_TIMEOUT_MS=120000
APP_AI_AGENTS_OUTBOX_RETRY_BASE_DELAY_MS=30000
APP_AI_AGENTS_OUTBOX_RETRY_MAX_DELAY_MS=900000

# Confirmacion publica de reservas por enlace
APP_BOOKING_CONFIRMATION_EXPIRATION_MINUTES=30
APP_BOOKING_CONFIRMATION_EXPIRATION_SCAN_MS=60000
APP_BOOKING_CONFIRMATION_PUBLIC_BASE_URL=http://localhost:5173/reservas/confirmar
APP_BOOKING_CONFIRMATION_DISPATCH_WHATSAPP=false

# Recuperacion de contrasena por email transaccional.
# No incluir credenciales reales en archivos versionados.
APP_EMAIL_ENABLED=true
APP_EMAIL_SIMULATION_ENABLED=true
APP_EMAIL_HEALTH_ENABLED=false
APP_EMAIL_FROM=no-reply@localhost
APP_EMAIL_FROM_NAME=Centro Estetico Bella
APP_FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
# !!! REEMPLAZAR con credenciales reales de Gmail SMTP (App Password) !!!
SPRING_MAIL_USERNAME=tu-email@gmail.com
SPRING_MAIL_PASSWORD=tu-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=false

# Pasarela de pago
# Proveedor actual: SIMULATED | MERCADOPAGO
APP_BOOKING_PAYMENT_PROVIDER=SIMULATED
APP_MERCADOPAGO_ACCESS_TOKEN=
APP_MERCADOPAGO_NOTIFICATION_URL=
APP_BOOKING_PAYMENT_WEBHOOK_SECRET=
APP_BOOKING_PAYMENT_WEBHOOK_SIGNATURE_ENABLED=true

# Trazabilidad backend
APP_METHOD_TRACING_ENABLED=true
APP_METHOD_TRACING_LOG_ARGUMENTS=true
APP_METHOD_TRACING_LOG_RESULT=false
APP_METHOD_TRACING_MAX_PAYLOAD_LENGTH=1200
APP_METHOD_TRACING_SLOW_THRESHOLD_MS=1500
