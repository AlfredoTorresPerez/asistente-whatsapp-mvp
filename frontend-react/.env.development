VITE_API_BASE_URL=http://localhost:8080/api/v1

# ⚠️ LOCAL/DEMO ONLY: muestra credenciales predefinidas en pantalla de login
# En producción o demos controladas debe ser false
VITE_SHOW_DEMO_CREDENTIALS=true

VITE_FRONTEND_TRACE_ENABLED=true
VITE_TRACE_MAX_PAYLOAD_LENGTH=1200

# Meta Embedded Signup (completar con valores reales para probar onboarding)
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v23.0
