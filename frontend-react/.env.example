VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SHOW_DEMO_CREDENTIALS=false

# Trazabilidad de consola en navegador
VITE_FRONTEND_TRACE_ENABLED=true
VITE_TRACE_MAX_PAYLOAD_LENGTH=1200

# WhatsApp para páginas públicas
VITE_PUBLIC_WHATSAPP_NUMBER=56927305158
VITE_PUBLIC_WHATSAPP_MESSAGE=Hola, quiero solicitar información y agendar una hora en Centro Estética Bella.

# Reporte de errores del navegador al backend
VITE_CLIENT_ERROR_REPORTING_ENABLED=true
VITE_CLIENT_ERROR_REPORT_INTERVAL_MS=2000
