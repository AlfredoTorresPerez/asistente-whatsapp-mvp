# =============================================================================
# ENTORNO LOCAL - WHATSAPP WEB SERVICE
# =============================================================================
# Copia este archivo a .env.local y ajusta según necesites
# docker compose -f docker-compose.local.yml --env-file .env.local up -d

# -----------------------------------------------------------------------------
# WHATSAPP WEB SERVICE (adaptador experimental whatsapp-web.js)
# -----------------------------------------------------------------------------
# Puerto del servicio HTTP
WHATSAPP_WEB_PORT=3001

# API Key para autenticar requests al adaptador
WHATSAPP_WEB_API_KEY=dev-whatsapp-web-key

# ID de sesión (usado por LocalAuth para persistir sesión)
WHATSAPP_WEB_SESSION_ID=demo-sales

# Habilitar cliente real de whatsapp-web.js (Puppeteer + Chromium)
WHATSAPP_WEB_REAL_ENABLED=true

# Conectar automáticamente al iniciar (requiere QR previo escaneado)
WHATSAPP_WEB_AUTO_CONNECT=true

# Número de teléfono de la empresa (formato E.164 sin +)
WHATSAPP_WEB_COMPANY_PHONE_NUMBER=56927305158
WHATSAPP_WEB_DEFAULT_PHONE_NUMBER=56927305158

# Número de teléfono de prueba para simulación
WHATSAPP_WEB_TEST_CUSTOMER_PHONE_NUMBER=56950954580

# URL del webhook del backend Java
WHATSAPP_WEB_BACKEND_WEBHOOK_URL=http://backend-java:8080/api/v1/integrations/whatsapp-web/webhook

# Secret para firmar/validar webhooks (HMAC-SHA256)
WHATSAPP_WEB_WEBHOOK_SECRET=dev-whatsapp-web-webhook-secret

# Rutas de persistencia (volúmenes Docker)
WHATSAPP_WEB_SESSION_DATA_PATH=/app/.wwebjs_auth
WHATSAPP_WEB_CACHE_PATH=/app/.wwebjs_cache

# -----------------------------------------------------------------------------
# MODO HEADLESS (RECOMENDADO PARA LOCAL)
# -----------------------------------------------------------------------------
# Headless: true = sin interfaz gráfica (más estable, menos memoria)
# Headless: false = requiere VNC/Xvfb (solo para debug visual)
WHATSAPP_WEB_HEADLESS=true

# Modo visual: false = no levanta VNC/noVNC (ahorra 500MB+ RAM)
# Si necesitas ver el navegador: WHATSAPP_WEB_VISUAL_MODE=true con profile "whatsapp"
WHATSAPP_WEB_VISUAL_MODE=false

# URL del visor VNC (solo si VISUAL_MODE=true)
WHATSAPP_WEB_BROWSER_VIEWER_URL=http://localhost:6080/vnc.html?autoconnect=true&resize=scale

# -----------------------------------------------------------------------------
# CHROMIUM / PUPPETEER
# -----------------------------------------------------------------------------
WHATSAPP_WEB_CHROME_EXECUTABLE=/usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Limpiar locks de perfil Chromium al iniciar (evita "Profile in use")
WHATSAPP_WEB_CLEAN_PROFILE_LOCKS_ON_START=true

# Matar procesos Chromium huérfanos al iniciar
WHATSAPP_WEB_KILL_ORPHAN_CHROMIUM_ON_START=true

# Cache de versión Web (none = sin cache, local = filesystem, remote = S3)
WHATSAPP_WEB_WEB_VERSION_CACHE=none

# Reintentos de inicialización de Chromium
WHATSAPP_WEB_INIT_RETRIES=5
WHATSAPP_WEB_INIT_RETRY_DELAY_MS=10000

# Timeouts de Puppeteer
WHATSAPP_WEB_PUPPETEER_PROTOCOL_TIMEOUT_MS=180000
WHATSAPP_WEB_PUPPETEER_TIMEOUT_MS=180000

# Delay antes de reintentar conexión tras desconexión
WHATSAPP_WEB_RUNTIME_RECOVERY_DELAY_MS=5000

# Args extra para Chromium (separados por |)
WHATSAPP_WEB_CHROME_EXTRA_ARGS=--disable-features=Translate,BackForwardCache,AcceptCHFrame,MediaRouter,OptimizationHints|--disable-background-timer-throttling|--disable-backgrounding-occluded-windows|--disable-renderer-backgrounding

# -----------------------------------------------------------------------------
# IA / AUTO-REPLY
# -----------------------------------------------------------------------------
APP_AI_AGENTS_ENABLED=true
APP_AI_AGENTS_AUTO_REPLY_ENABLED=true
APP_AI_AGENTS_AUDIT_ENABLED=true
APP_AI_AGENTS_SAFE_MODE_ENABLED=false
APP_AI_AGENTS_OUTBOX_WORKER_INTERVAL_MS=2000
APP_AI_AGENTS_OUTBOX_BATCH_SIZE=5
APP_OPENAI_ENABLED=false

# -----------------------------------------------------------------------------
# DEMO FALLBACK (DESHABILITAR PARA VER ERRORES REALES)
# -----------------------------------------------------------------------------
APP_WHATSAPP_WEB_DEMO_FALLBACK_ENABLED=false

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_JSON=true