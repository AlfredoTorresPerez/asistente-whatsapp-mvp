WHATSAPP_WEB_PORT=3001
WHATSAPP_WEB_API_KEY=dev-whatsapp-web-key
WHATSAPP_WEB_SESSION_ID=demo-sales
WHATSAPP_WEB_REAL_ENABLED=true
WHATSAPP_WEB_AUTO_CONNECT=true
WHATSAPP_WEB_DEFAULT_PHONE_NUMBER=56900000000
WHATSAPP_WEB_COMPANY_PHONE_NUMBER=56900000000
WHATSAPP_WEB_TEST_CUSTOMER_PHONE_NUMBER=56950954580
WHATSAPP_WEB_BACKEND_WEBHOOK_URL=http://backend-java:8080/api/v1/integrations/whatsapp-web/webhook
WHATSAPP_WEB_WEBHOOK_SECRET=dev-whatsapp-web-webhook-secret
WHATSAPP_WEB_SESSION_DATA_PATH=/app/.wwebjs_auth
WHATSAPP_WEB_CACHE_PATH=/app/.wwebjs_cache
WHATSAPP_WEB_HEADLESS=true
WHATSAPP_WEB_VISUAL_MODE=false
WHATSAPP_WEB_BROWSER_VIEWER_URL=http://localhost:6080/vnc.html?autoconnect=true&resize=scale
WHATSAPP_WEB_CHROME_EXECUTABLE=/usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WHATSAPP_WEB_CLEAN_PROFILE_LOCKS_ON_START=true
WHATSAPP_WEB_KILL_ORPHAN_CHROMIUM_ON_START=true
WHATSAPP_WEB_WEB_VERSION_CACHE=none
WHATSAPP_WEB_INIT_RETRIES=5
WHATSAPP_WEB_INIT_RETRY_DELAY_MS=10000
WHATSAPP_WEB_PUPPETEER_PROTOCOL_TIMEOUT_MS=180000
WHATSAPP_WEB_PUPPETEER_TIMEOUT_MS=180000
WHATSAPP_WEB_RUNTIME_RECOVERY_DELAY_MS=5000
WHATSAPP_WEB_CHROME_EXTRA_ARGS=--disable-features=Translate,BackForwardCache,AcceptCHFrame,MediaRouter,OptimizationHints|--disable-background-timer-throttling|--disable-backgrounding-occluded-windows|--disable-renderer-backgrounding