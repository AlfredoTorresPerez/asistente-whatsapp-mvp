# =============================================================================
# ENV PRODUCCION - ASISTENTE WHATSAPP MVP
# =============================================================================
# Copiar a .env y completar valores reales (nunca committear .env)
# =============================================================================

# Rate limiting
APP_RATE_LIMITING_ENABLED=true

# Entorno
SPRING_PROFILES_ACTIVE=production

# --- BASE DE DATOS ---
POSTGRES_DB=asistente_whatsapp
POSTGRES_USER=assistant
POSTGRES_PASSWORD=<cambiar-contraseña-robusta-32-caracteres>

# --- BACKEND ---
APP_JWT_SECRET=<cambiar-secreto-jwt-256-bits>
APP_ENVIRONMENT=production
APP_CORS_ALLOWED_ORIGINS=https://admin.midominio.cl

# --- WHATSAPP CLOUD API ---
APP_WHATSAPP_CHANNEL_PROVIDER=META_CLOUD_API
APP_WHATSAPP_CLOUD_API_ENABLED=true
APP_WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
APP_WHATSAPP_CLOUD_API_VERSION=v23.0
APP_WHATSAPP_CLOUD_API_APP_ID=<meta-app-id>
APP_WHATSAPP_CLOUD_API_APP_SECRET=<app-secret>
APP_WHATSAPP_CLOUD_API_WEBHOOK_VERIFY_TOKEN=<webhook-verify-token>
APP_WHATSAPP_CLOUD_API_WEBHOOK_PUBLIC_URL=https://admin.midominio.cl/api/v1/integrations/whatsapp-cloud/webhook
APP_WHATSAPP_CLOUD_API_WEBHOOK_SIGNATURE_REQUIRED=true
APP_WHATSAPP_CLOUD_API_CREDENTIAL_ENCRYPTION_SECRET=<encryption-secret-32-caracteres+>
APP_WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=<phone-number-id>
APP_WHATSAPP_CLOUD_API_BUSINESS_ACCOUNT_ID=<waba-id>
APP_WHATSAPP_CLOUD_API_ACCESS_TOKEN=<access-token>
APP_WHATSAPP_CLOUD_API_CONNECT_TIMEOUT_SECONDS=5
APP_WHATSAPP_CLOUD_API_READ_TIMEOUT_SECONDS=15
APP_WHATSAPP_CLOUD_API_DRY_RUN_ENABLED=false

# Frontend Meta vars (se inyectan durante build)
VITE_API_BASE_URL=/api/v1
VITE_META_APP_ID=<meta-app-id>
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=<embedded-signup-config-id>
VITE_META_GRAPH_API_VERSION=v23.0

# --- PAGOS ---
# Proveedor: SIMULATED | MERCADOPAGO | TRANSBANK_MALL
APP_BOOKING_PAYMENT_PROVIDER=SIMULATED

# MercadoPago (si aplica)
APP_MERCADOPAGO_ACCESS_TOKEN=
APP_MERCADOPAGO_WEBHOOK_SECRET=

# Transbank (si aplica)
APP_TRANSBANK_ENABLED=false
APP_TRANSBANK_ENVIRONMENT=integration
APP_TRANSBANK_MALL_COMMERCE_CODE=
APP_TRANSBANK_SECRET_KEY=

# --- EMAIL ---
APP_EMAIL_ENABLED=true
APP_EMAIL_SIMULATION_ENABLED=false
SPRING_MAIL_HOST=smtp.midominio.cl
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=no-reply@midominio.cl
SPRING_MAIL_PASSWORD=<smtp-password>

# --- MONITOREO ---
SENTRY_DSN=
SLACK_WEBHOOK_URL=

# --- CADDY/DOMINIO ---
DOMAIN=admin.midominio.cl
