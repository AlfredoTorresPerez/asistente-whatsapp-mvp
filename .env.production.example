POSTGRES_DB=asistente_whatsapp
POSTGRES_USER=assistant
POSTGRES_PASSWORD=replace-with-secure-password
APP_JWT_SECRET=replace-with-secure-random-secret-min-32-chars
APP_ENVIRONMENT=production
APP_CORS_ALLOWED_ORIGINS=https://tu-dominio.cl
APP_WHATSAPP_CHANNEL_PROVIDER=CLOUD_API
APP_WHATSAPP_WEB_ENABLED=false
APP_WHATSAPP_CLOUD_API_ENABLED=true
APP_WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
APP_WHATSAPP_CLOUD_API_VERSION=v23.0
APP_WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=replace-with-phone-number-id
APP_WHATSAPP_CLOUD_API_ACCESS_TOKEN=replace-with-access-token
APP_WHATSAPP_CLOUD_API_DEFAULT_PHONE_NUMBER=56950954580
APP_WHATSAPP_CLOUD_API_DRY_RUN_ENABLED=false
VITE_API_BASE_URL=https://api.tu-dominio.cl/api/v1

# Pasarela de pago
# ⚠️  SIMULATED solo para demo local. En produccion real cambiar a MERCADOPAGO
#     y configurar APP_MERCADOPAGO_ACCESS_TOKEN, NOTIFICATION_URL y WEBHOOK_SECRET.
# Proveedor: SIMULATED | MERCADOPAGO
APP_BOOKING_PAYMENT_PROVIDER=MERCADOPAGO
APP_BOOKING_PAYMENT_WEBHOOK_PUBLIC_URL=https://api.tu-dominio.cl/api/v1/integrations/booking-payments/webhook
APP_BOOKING_PAYMENT_CHECKOUT_PUBLIC_BASE_URL=https://tu-dominio.cl/reservas/pagar
APP_BOOKING_PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
APP_BOOKING_PAYMENT_WEBHOOK_SIGNATURE_ENABLED=true
APP_BOOKING_PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
APP_MERCADOPAGO_ACCESS_TOKEN=replace-with-mercadopago-access-token
APP_MERCADOPAGO_WEBHOOK_SECRET=replace-with-mercadopago-webhook-secret
APP_MERCADOPAGO_NOTIFICATION_URL=https://api.tu-dominio.cl/api/v1/integrations/booking-payments/webhook

# Orquestador multiagente
APP_AI_AGENTS_ENABLED=true
APP_AI_AGENTS_AUTO_REPLY_ENABLED=false
APP_AI_AGENTS_AUDIT_ENABLED=true
APP_AI_AGENTS_DEFAULT_CONFIDENCE=0.78
