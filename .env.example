POSTGRES_DB=asistente_whatsapp
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
APP_JWT_SECRET=change-this-secret-in-local-development-please-2026
APP_ENVIRONMENT=local
APP_ACCESS_TOKEN_EXPIRES_IN_SECONDS=28800
APP_DEMO_INTERNAL_TOKEN=dev-demo-internal-token
WHATSAPP_BUSINESS_PHONE_LABEL=WhatsApp empresa
WHATSAPP_BUSINESS_PHONE_NUMBER=56900000000
WHATSAPP_SESSION_ID=demo-sales
WHATSAPP_BACKEND_WEBHOOK_URL=http://backend-java:8080/api/v1/integrations/whatsapp-web/webhook
WHATSAPP_ADAPTER_MODE=WHATSAPP_WEB_LOCAL
WHATSAPP_REQUIRE_DEDICATED_BUSINESS_NUMBER=true
APP_WHATSAPP_CHANNEL_PROVIDER=WEB
APP_WHATSAPP_WEB_ENABLED=true
APP_WHATSAPP_WEB_API_KEY=dev-whatsapp-web-key
APP_WHATSAPP_WEB_WEBHOOK_SECRET=dev-whatsapp-web-webhook-secret
WHATSAPP_WEB_SESSION_ID=demo-sales
WHATSAPP_WEB_REAL_ENABLED=true
WHATSAPP_WEB_AUTO_CONNECT=false
WHATSAPP_WEB_VISUAL_MODE=true
WHATSAPP_WEB_HEADLESS=false

# Pruebas locales con numero empresa virtual y numero cliente separado
WHATSAPP_WEB_COMPANY_PHONE_NUMBER=56900000000
WHATSAPP_WEB_TEST_CUSTOMER_PHONE_NUMBER=56950954580
APP_WHATSAPP_WEB_DEFAULT_PHONE_NUMBER=56900000000

# Confirmacion publica de reservas por enlace
# IMPORTANTE: si se enviaran enlaces reales por WhatsApp, no usar localhost.
# Para pruebas con un telefono externo, usar un dominio publico o un tunel HTTPS hacia el frontend.
APP_BOOKING_CONFIRMATION_EXPIRATION_MINUTES=60
APP_BOOKING_CONFIRMATION_EXPIRATION_SCAN_MS=60000
APP_BOOKING_CONFIRMATION_PUBLIC_BASE_URL=http://localhost:5173/reservas/confirmar
APP_BOOKING_CONFIRMATION_DISPATCH_WHATSAPP=false

# Recuperacion de contrasena por email transaccional.
# No incluir credenciales reales en archivos versionados.
APP_EMAIL_ENABLED=true
APP_EMAIL_SIMULATION_ENABLED=true
APP_EMAIL_HEALTH_ENABLED=false
APP_EMAIL_FROM=no-reply@localhost
APP_EMAIL_FROM_NAME=Centro Estetico Bella
APP_FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
# !!! REEMPLAZAR con credenciales reales de Gmail SMTP (App Password) !!!
SPRING_MAIL_USERNAME=tu-email@gmail.com
SPRING_MAIL_PASSWORD=tu-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=false

# Enlace publico navegable para clientes externos.
# Para WhatsApp real, debe ser https y accesible desde el telefono del cliente.
# Puedes generarlo en local con: ./scripts/start_mvp_public_link.sh
# Ejemplo: APP_BOOKING_CONFIRMATION_PUBLIC_BASE_URL=https://mi-tunel.trycloudflare.com/reservas/confirmar
VITE_API_BASE_URL=/api/v1

# Zona horaria local para backend, WhatsApp Web, PostgreSQL y VNC.
TZ=America/Santiago
JAVA_TOOL_OPTIONS=-Duser.timezone=America/Santiago
SPRING_JACKSON_TIME_ZONE=America/Santiago
APP_TIME_ZONE=America/Santiago

# Cola persistente / outbox IA
APP_AI_AGENTS_OUTBOX_WORKER_INTERVAL_MS=5000
APP_AI_AGENTS_OUTBOX_BATCH_SIZE=10
APP_AI_AGENTS_OUTBOX_PROCESSING_TIMEOUT_MS=120000
APP_AI_AGENTS_OUTBOX_RETRY_BASE_DELAY_MS=30000
APP_AI_AGENTS_OUTBOX_RETRY_MAX_DELAY_MS=900000

# Trazabilidad frontend/backend
VITE_FRONTEND_TRACE_ENABLED=true
VITE_TRACE_MAX_PAYLOAD_LENGTH=1200
APP_METHOD_TRACING_ENABLED=true
APP_METHOD_TRACING_LOG_ARGUMENTS=true
APP_METHOD_TRACING_LOG_RESULT=false
APP_METHOD_TRACING_MAX_PAYLOAD_LENGTH=1200
APP_METHOD_TRACING_SLOW_THRESHOLD_MS=1500
