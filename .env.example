# Rate limiting (proteccion fuerza bruta)
APP_RATE_LIMITING_ENABLED=true

# Configuracion pasarela de pago
# Proveedor: SIMULATED (demo/QA) | MERCADOPAGO (produccion real) | TRANSBANK_MALL (Webpay Plus Mall)
APP_BOOKING_PAYMENT_PROVIDER=SIMULATED
APP_BOOKING_PAYMENT_WEBHOOK_PUBLIC_URL=
APP_BOOKING_PAYMENT_CHECKOUT_PUBLIC_BASE_URL=http://localhost:5173/reservas/pagar
APP_BOOKING_PAYMENT_CHECKOUT_EXPIRATION_MINUTES=30
APP_BOOKING_PAYMENT_WEBHOOK_SECRET=
APP_BOOKING_PAYMENT_WEBHOOK_SIGNATURE_ENABLED=true
APP_BOOKING_PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
APP_BOOKING_PAYMENT_DISPATCH_WHATSAPP=false
APP_BOOKING_PAYMENT_DISPATCH_EMAIL=true
APP_BOOKING_PAYMENT_DISPATCH_POST_PAYMENT_WHATSAPP=false
APP_BOOKING_PAYMENT_DISPATCH_POST_PAYMENT_EMAIL=true
APP_BOOKING_PAYMENT_EXPIRATION_SCAN_MS=60000
APP_BOOKING_PAYMENT_EXPIRATION_BATCH_SIZE=100

# MercadoPago (solo para proveedor MERCADOPAGO)
APP_MERCADOPAGO_ACCESS_TOKEN=
APP_MERCADOPAGO_WEBHOOK_SECRET=
APP_MERCADOPAGO_NOTIFICATION_URL=

# Transbank Webpay Plus Mall
APP_TRANSBANK_ENABLED=false
APP_TRANSBANK_ENVIRONMENT=integration
APP_TRANSBANK_MALL_COMMERCE_CODE=
APP_TRANSBANK_SECRET_KEY=
APP_TRANSBANK_RETURN_URL=http://localhost:5173/reservas/pagar/return
APP_TRANSBANK_SUCCESS_URL=http://localhost:5173/reservas/pagar/success
APP_TRANSBANK_FAILURE_URL=http://localhost:5173/reservas/pagar/failure
APP_TRANSBANK_TOKEN_VALIDITY_MINUTES=5

# Google Calendar Integration
APP_CALENDAR_GOOGLE_ENABLED=false
APP_CALENDAR_GOOGLE_CLIENT_ID=
APP_CALENDAR_GOOGLE_CLIENT_SECRET=
APP_CALENDAR_GOOGLE_REDIRECT_URI=
APP_CALENDAR_ENCRYPTION_SECRET=
APP_CALENDAR_SYNC_ENABLED=true
APP_CALENDAR_SYNC_RETRY_INTERVAL_MS=300000
APP_CALENDAR_SYNC_MAX_RETRIES=5
APP_FRONTEND_PUBLIC_BASE_URL=http://localhost:5173