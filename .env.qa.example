# =============================================================================
# ASISTENTE WHATSAPP MVP - CONFIGURACIÓN QA
# =============================================================================
# Copia este archivo a .env.qa, completa los valores y ejecuta:
#   docker compose --env-file .env.qa -f docker-compose.qa.yml up -d
# =============================================================================

# Entorno
SPRING_PROFILES_ACTIVE=qa

# --- ZONA HORARIA ---
TZ=America/Santiago

# --- BASE DE DATOS ---
POSTGRES_DB=asistente_qa
POSTGRES_USER=assistant
POSTGRES_PASSWORD=<cambiar-contraseña-robusta>

# --- BACKEND ---
APP_DB_URL=jdbc:postgresql://postgres:5432/asistente_qa
APP_DB_USERNAME=assistant
APP_DB_PASSWORD=<cambiar-contraseña-robusta>
APP_JWT_SECRET=<cambiar-secreto-jwt-256-bits>
APP_ENVIRONMENT=qa
APP_CORS_ALLOWED_ORIGINS=https://qa-admin.midominio.cl
APP_FRONTEND_PUBLIC_BASE_URL=https://qa-admin.midominio.cl

# --- WHATSAPP CLOUD API (obligatorio en QA) ---
APP_WHATSAPP_CHANNEL_PROVIDER=META_CLOUD_API
APP_WHATSAPP_CLOUD_API_ENABLED=true
APP_WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
APP_WHATSAPP_CLOUD_API_VERSION=v23.0
APP_WHATSAPP_CLOUD_API_APP_ID=<meta-app-id>
APP_WHATSAPP_CLOUD_API_APP_SECRET=<meta-app-secret>
APP_WHATSAPP_CLOUD_API_ACCESS_TOKEN=<meta-access-token>
APP_WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=<phone-number-id>
APP_WHATSAPP_CLOUD_API_BUSINESS_ACCOUNT_ID=<waba-id>
APP_WHATSAPP_CLOUD_API_WEBHOOK_VERIFY_TOKEN=<webhook-verify-token>
APP_WHATSAPP_CLOUD_API_WEBHOOK_PUBLIC_URL=https://qa-admin.midominio.cl/api/v1/integrations/whatsapp-cloud/webhook
APP_WHATSAPP_CLOUD_API_WEBHOOK_SIGNATURE_REQUIRED=true
APP_WHATSAPP_CLOUD_API_CREDENTIAL_ENCRYPTION_SECRET=<32-char-alphanumeric>
APP_WHATSAPP_CLOUD_API_CONNECT_TIMEOUT_SECONDS=5
APP_WHATSAPP_CLOUD_API_READ_TIMEOUT_SECONDS=15
APP_WHATSAPP_CLOUD_API_DRY_RUN_ENABLED=false

# --- AI / OPENAI ---
APP_AI_AGENTS_ENABLED=true
APP_AI_AGENTS_AUTO_REPLY_ENABLED=true
APP_AI_AGENTS_SAFE_MODE_ENABLED=false
APP_OPENAI_ENABLED=true
APP_OPENAI_API_KEY=<openai-api-key>

# --- BOOKING PUBLIC URLS ---
APP_BOOKING_CONFIRMATION_PUBLIC_BASE_URL=https://qa-admin.midominio.cl/reservas/confirmar
APP_BOOKING_RESCHEDULE_PUBLIC_BASE_URL=https://qa-admin.midominio.cl/reservas/reprogramar
APP_BOOKING_CANCELLATION_PUBLIC_BASE_URL=https://qa-admin.midominio.cl/reservas/cancelar
APP_BOOKING_PAYMENT_CHECKOUT_PUBLIC_BASE_URL=https://qa-admin.midominio.cl/reservas/pagar

# --- PAGOS ---
APP_BOOKING_PAYMENT_PROVIDER=SIMULATED
APP_MERCADOPAGO_ACCESS_TOKEN=

# --- EMAIL ---
APP_EMAIL_ENABLED=true
APP_EMAIL_SIMULATION_ENABLED=false
SPRING_MAIL_HOST=smtp.midominio.cl
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=no-reply@midominio.cl
SPRING_MAIL_PASSWORD=<smtp-password>

# --- FRONTEND (se inyectan en build) ---
VITE_API_BASE_URL=/api/v1
VITE_META_APP_ID=<meta-app-id>
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v23.0

# --- CADDY/DOMINIO ---
DOMAIN=qa-admin.midominio.cl

# --- PUERTOS (opcional, defaults) ---
POSTGRES_PORT=5434
BACKEND_PORT=8082
FRONTEND_PORT=8081
