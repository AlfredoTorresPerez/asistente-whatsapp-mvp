{
    auto_https disable_redirects
    local_certs
}

localhost, caddy.localhost {
    tls internal

    @backend {
        path /api/* /v3/* /swagger-ui/* /actuator/*
    }
    reverse_proxy @backend backend-java:8080

    @frontend {
        path /*
    }
    reverse_proxy @frontend frontend-react:5173
}
